{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      },
      "required": ["repository", "pullPolicy", "tag"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"]
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      },
      "required": ["create", "annotations", "name"]
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "port"]
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array", "items": { "type": "object" } },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "matches": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
              "filters": { "type": "array", "items": { "type": "object" } },
              "timeouts": { "type": "object" }
            },
            "required": ["matches"]
          }
        }
      },
      "required": ["enabled", "annotations", "parentRefs", "hostnames", "rules"]
    },
    "fileServer": {
      "type": "object",
      "properties": {
        "listen": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string", "format": "uri" },
        "postgresql": {
          "type": "object",
          "properties": {
            "maxConnections": { "type": "integer", "minimum": 1 },
            "secretKeyRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              },
              "required": ["name", "key"]
            }
          },
          "required": ["maxConnections", "secretKeyRef"]
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string", "format": "uri" },
            "clientId": { "type": "string", "minLength": 1 },
            "secretKeyRef": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              },
              "required": ["name", "key"]
            },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "sessionTtlSecs": { "type": "integer", "minimum": 1 },
            "loginTtlSecs": { "type": "integer", "minimum": 1 },
            "cookieName": { "type": "string", "minLength": 1 },
            "successPath": { "type": "string", "minLength": 1 }
          },
          "required": ["issuer", "clientId", "secretKeyRef", "scopes", "sessionTtlSecs", "loginTtlSecs", "cookieName", "successPath"]
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
              "persistentVolumeClaimName": { "type": "string", "minLength": 1 }
            },
            "required": ["name", "persistentVolumeClaimName"]
          }
        }
      },
      "required": ["listen", "publicUrl", "postgresql", "oidc", "mounts"]
    },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  },
  "required": [
    "replicaCount", "image", "imagePullSecrets", "nameOverride", "fullnameOverride",
    "serviceAccount", "podAnnotations", "podLabels", "podSecurityContext", "securityContext",
    "service", "httpRoute", "fileServer", "resources", "nodeSelector", "tolerations", "affinity"
  ]
}
